<controls:ShellWindow x:Class="TeamSpeak9.App.Views.ChannelEditorWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
                      xmlns:controls="clr-namespace:TeamSpeak9.App.Controls"
                      xmlns:conv="clr-namespace:TeamSpeak9.App.Converters"
                      Title="{Binding Title}"
                      Width="640"
                      Height="720"
                      MinWidth="520"
                      MinHeight="480"
                      ShowInTaskbar="False"
                      WindowStartupLocation="CenterOwner">

  <controls:ShellWindow.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />

    <!-- Labels sit in the left column of every form row; the fixed width keeps all fields aligned
         across sections without a shared size group. -->
    <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.BodySecondary}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="FormRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionHeader}">
      <Setter Property="Margin" Value="0,6,0,10" />
    </Style>
  </controls:ShellWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Same caption arrangement as the shell: Windows owns the strip, only the buttons opt back
         in to hit testing. -->
    <Grid Grid.Row="0"
          Height="{StaticResource Size.CaptionHeight}"
          Background="{StaticResource Brush.Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{Binding Title}"
                 Style="{StaticResource Text.Subtitle}"
                 VerticalAlignment="Center"
                 Margin="14,0,0,0" />

      <Button Grid.Column="1"
              Style="{StaticResource Button.CaptionClose}"
              Command="{x:Static sw:SystemCommands.CloseWindowCommand}"
              VerticalAlignment="Top"
              Margin="0,8,8,0"
              ToolTip="关闭">
        <controls:IconGlyph Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,4,18,12">
      <StackPanel>

        <TextBlock Text="基本信息" Style="{StaticResource SectionHeader}" />

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="频道名称" Style="{StaticResource FormLabel}" />
          <TextBox x:Name="NameBox"
                   Grid.Column="1"
                   Style="{StaticResource TextBox.Base}"
                   MaxLength="40"
                   Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="拼音名称" Style="{StaticResource FormLabel}" />
          <TextBox x:Name="PhoneticBox"
                   Grid.Column="1"
                   Style="{StaticResource TextBox.Base}"
                   Text="{Binding PhoneticName}" />
        </Grid>

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="主题" Style="{StaticResource FormLabel}" />
          <TextBox x:Name="TopicBox"
                   Grid.Column="1"
                   Style="{StaticResource TextBox.Base}"
                   Text="{Binding Topic}" />
        </Grid>

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="描述" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
          <TextBox x:Name="DescriptionBox"
                   Grid.Column="1"
                   Style="{StaticResource TextBox.Multiline}"
                   Height="90"
                   Text="{Binding Description}" />
        </Grid>

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="密码" Style="{StaticResource FormLabel}" />
          <StackPanel Grid.Column="1">
            <PasswordBox x:Name="ChannelPasswordBox"
                         PasswordChanged="OnPasswordChanged" />
            <TextBlock Text="{Binding PasswordHint}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Separator Margin="0,6,0,10" />
        <TextBlock Text="类型与生命周期" Style="{StaticResource SectionHeader}" />

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="频道类型" Style="{StaticResource FormLabel}" />
          <ComboBox x:Name="KindBox"
                    Grid.Column="1"
                    ItemsSource="{Binding KindOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding Kind}" />
        </Grid>

        <Grid Style="{StaticResource FormRow}"
              IsEnabled="{Binding SupportsDeleteDelay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="删除延迟（秒）" Style="{StaticResource FormLabel}" />
          <StackPanel Grid.Column="1">
            <TextBox x:Name="DeleteDelayBox"
                     Style="{StaticResource TextBox.Base}"
                     Width="120"
                     HorizontalAlignment="Left"
                     Text="{Binding DeleteDelaySeconds}" />
            <TextBlock Text="频道空置后等待多久删除；0 表示立即删除。仅临时频道适用。"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <CheckBox x:Name="DefaultChannelBox"
                  Content="设为默认频道（新加入的客户端进入此频道）"
                  IsChecked="{Binding IsDefault}"
                  Margin="0,0,0,10" />

        <Separator Margin="0,6,0,10" />
        <TextBlock Text="人数限制" Style="{StaticResource SectionHeader}" />

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="本频道上限" Style="{StaticResource FormLabel}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <CheckBox x:Name="MaxClientsUnlimitedBox"
                      Content="不限"
                      IsChecked="{Binding MaxClientsUnlimited}"
                      VerticalAlignment="Center" />
            <TextBox x:Name="MaxClientsBox"
                     Style="{StaticResource TextBox.Base}"
                     Width="100"
                     Margin="14,0,0,0"
                     IsEnabled="{Binding IsMaxClientsLimited}"
                     Text="{Binding MaxClientsCount}" />
          </StackPanel>
        </Grid>

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="含子频道上限" Style="{StaticResource FormLabel}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ComboBox x:Name="MaxFamilyModeBox"
                      Width="160"
                      ItemsSource="{Binding FamilyModeOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding MaxFamilyMode}" />
            <TextBox x:Name="MaxFamilyBox"
                     Style="{StaticResource TextBox.Base}"
                     Width="100"
                     Margin="14,0,0,0"
                     IsEnabled="{Binding IsMaxFamilyLimited}"
                     Text="{Binding MaxFamilyCount}" />
          </StackPanel>
        </Grid>

        <Separator Margin="0,6,0,10" />
        <TextBlock Text="语音" Style="{StaticResource SectionHeader}" />

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="编解码器" Style="{StaticResource FormLabel}" />
          <ComboBox x:Name="CodecBox"
                    Grid.Column="1"
                    ItemsSource="{Binding CodecOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding Codec}" />
        </Grid>

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="音质" Style="{StaticResource FormLabel}" />
          <Slider x:Name="QualitySlider"
                  Grid.Column="1"
                  Minimum="0"
                  Maximum="10"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  VerticalAlignment="Center"
                  Value="{Binding CodecQuality}" />
          <TextBlock Grid.Column="2"
                     Text="{Binding CodecQuality}"
                     Style="{StaticResource Text.Mono}"
                     VerticalAlignment="Center"
                     MinWidth="24"
                     TextAlignment="Right"
                     Margin="10,0,0,0" />
        </Grid>

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="延迟因数" Style="{StaticResource FormLabel}" />
          <TextBox x:Name="LatencyBox"
                   Grid.Column="1"
                   Style="{StaticResource TextBox.Base}"
                   Width="100"
                   HorizontalAlignment="Left"
                   Text="{Binding CodecLatencyFactor}" />
        </Grid>

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="所需谈话权限" Style="{StaticResource FormLabel}" />
          <TextBox x:Name="TalkPowerBox"
                   Grid.Column="1"
                   Style="{StaticResource TextBox.Base}"
                   Width="100"
                   HorizontalAlignment="Left"
                   Text="{Binding NeededTalkPower}" />
        </Grid>

        <CheckBox x:Name="UnencryptedBox"
                  Content="不加密语音数据（降低 CPU 占用，但同频道语音可被窃听）"
                  IsChecked="{Binding IsUnencrypted}"
                  Margin="0,0,0,10" />

        <Separator Margin="0,6,0,10" />
        <TextBlock Text="频道横幅" Style="{StaticResource SectionHeader}" />

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="图片地址" Style="{StaticResource FormLabel}" />
          <TextBox x:Name="BannerUrlBox"
                   Grid.Column="1"
                   Style="{StaticResource TextBox.Base}"
                   Text="{Binding BannerGfxUrl}" />
        </Grid>

        <Grid Style="{StaticResource FormRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="缩放方式" Style="{StaticResource FormLabel}" />
          <ComboBox x:Name="BannerModeBox"
                    Grid.Column="1"
                    ItemsSource="{Binding BannerModeOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding BannerMode}" />
        </Grid>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="18,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="ErrorLabel"
                   Grid.Column="0"
                   Text="{Binding ErrorText}"
                   Foreground="{StaticResource Brush.Danger}"
                   Style="{StaticResource Text.Body}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <!-- IsCancel alone closes with DialogResult=false, which is exactly what cancelling means,
               and it also wires up Esc. -->
          <Button x:Name="CancelButton"
                  Style="{StaticResource Button.Secondary}"
                  Content="取消"
                  IsCancel="True"
                  MinWidth="88" />
          <Button x:Name="SaveButton"
                  Style="{StaticResource Button.Primary}"
                  Content="{Binding SaveLabel}"
                  IsDefault="True"
                  MinWidth="88"
                  Margin="10,0,0,0"
                  Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</controls:ShellWindow>
