<controls:ShellWindow x:Class="TeamSpeak9.App.Views.IconBrowserWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
                      xmlns:controls="clr-namespace:TeamSpeak9.App.Controls"
                      xmlns:conv="clr-namespace:TeamSpeak9.App.Converters"
                      xmlns:vm="clr-namespace:TeamSpeak9.App.ViewModels"
                      Title="{Binding Title}"
                      Width="720"
                      Height="560"
                      MinWidth="560"
                      MinHeight="420"
                      ShowInTaskbar="False"
                      WindowStartupLocation="CenterOwner">

  <controls:ShellWindow.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <conv:IconIdToImageConverter x:Key="IconIdToImage" />
  </controls:ShellWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Same caption arrangement as the shell: Windows owns the strip, only the buttons opt back
         in to hit testing. -->
    <Grid Grid.Row="0"
          Height="{StaticResource Size.CaptionHeight}"
          Background="{StaticResource Brush.Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{Binding Title}"
                 Style="{StaticResource Text.Subtitle}"
                 VerticalAlignment="Center"
                 Margin="14,0,0,0" />

      <Button Grid.Column="1"
              Style="{StaticResource Button.CaptionClose}"
              Command="{x:Static sw:SystemCommands.CloseWindowCommand}"
              VerticalAlignment="Top"
              Margin="0,8,8,0"
              ToolTip="关闭">
        <controls:IconGlyph Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}" />
      </Button>
    </Grid>

    <!-- ===== Toolbar ===== -->
    <Border Grid.Row="1"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,1,0,1"
            Padding="14,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="UploadButton"
                Style="{StaticResource Button.Secondary}"
                Command="{Binding UploadCommand}"
                ToolTip="上传一张不超过 8 KB 的图片作为图标">
          <StackPanel Orientation="Horizontal">
            <controls:IconGlyph Data="{StaticResource Icon.Upload}" Style="{StaticResource Icon.Small}" />
            <TextBlock Text="上传图标" Margin="6,0,0,0" />
          </StackPanel>
        </Button>

        <Button x:Name="DeleteButton"
                Style="{StaticResource Button.Danger}"
                Margin="8,0,0,0"
                Command="{Binding DeleteCommand}"
                ToolTip="从服务器删除所选图标">
          <StackPanel Orientation="Horizontal">
            <controls:IconGlyph Data="{StaticResource Icon.Trash}" Style="{StaticResource Icon.Small}" />
            <TextBlock Text="删除" Margin="6,0,0,0" />
          </StackPanel>
        </Button>

        <Button x:Name="RefreshButton"
                Style="{StaticResource Button.IconSmall}"
                Margin="8,0,0,0"
                Command="{Binding RefreshCommand}"
                ToolTip="重新读取图标列表">
          <controls:IconGlyph Data="{StaticResource Icon.Refresh}" Style="{StaticResource Icon.Small}" />
        </Button>

        <ProgressBar Width="120"
                     Height="4"
                     Margin="12,0,0,0"
                     IsIndeterminate="True"
                     VerticalAlignment="Center"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
      </StackPanel>
    </Border>

    <!-- ===== Icon grid ===== -->
    <ListBox x:Name="IconGrid"
             Grid.Row="2"
             ItemsSource="{Binding Icons}"
             SelectedItem="{Binding Selected}"
             Padding="8"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="OnGridDoubleClick">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:IconTileViewModel}">
          <StackPanel Width="76"
                      Margin="4"
                      ToolTip="{Binding ToolTipText}">
            <Border Width="48"
                    Height="48"
                    Background="{StaticResource Brush.SurfaceSunken}"
                    CornerRadius="{StaticResource Radius.Small}"
                    HorizontalAlignment="Center">
              <Image Source="{Binding Id, Converter={StaticResource IconIdToImage}}"
                     Stretch="Uniform"
                     Margin="6" />
            </Border>
            <TextBlock Text="{Binding Label}"
                       Style="{StaticResource Text.Caption}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="2"
               Text="服务器上还没有自定义图标，点击“上传图标”添加。"
               Style="{StaticResource Text.BodySecondary}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

    <!-- ===== Footer ===== -->
    <Border Grid.Row="3"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="14,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusLabel"
                   Grid.Column="0"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasStatus}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="ClearIconButton"
                  Style="{StaticResource Button.Ghost}"
                  Content="移除图标"
                  MinWidth="88"
                  Command="{Binding ClearIconCommand}"
                  ToolTip="让该频道不显示图标" />
          <Button x:Name="CancelButton"
                  Style="{StaticResource Button.Secondary}"
                  Content="取消"
                  IsCancel="True"
                  MinWidth="88"
                  Margin="10,0,0,0" />
          <Button x:Name="ApplyButton"
                  Style="{StaticResource Button.Primary}"
                  Content="应用"
                  IsDefault="True"
                  MinWidth="88"
                  Margin="10,0,0,0"
                  Command="{Binding ApplyCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</controls:ShellWindow>
