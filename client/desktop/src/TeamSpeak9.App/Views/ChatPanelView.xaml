<UserControl x:Class="TeamSpeak9.App.Views.ChatPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeamSpeak9.App.Controls"
             xmlns:conv="clr-namespace:TeamSpeak9.App.Converters">

  <!-- Right column: channel header with the three tabs, the message list, and the composer with
       its BBCode toolbar. -->

  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
    <conv:NickColorConverter x:Key="NickColor" />
    <conv:EnumMatchConverter x:Key="EnumMatch" />
  </UserControl.Resources>

  <Grid Background="{StaticResource Brush.Surface}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Header ===== -->
    <Border Grid.Row="0"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:IconGlyph Grid.Column="0"
                            Data="{StaticResource Icon.Channel}"
                            VerticalAlignment="Center" />

        <TextBlock Grid.Column="1"
                   Text="{Binding ChatTitle}"
                   Style="{StaticResource Text.Subtitle}"
                   Margin="8,0,8,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <!-- RadioButtons rather than ToggleButtons: the group already enforces "exactly one", so
             no code is needed to un-check the others. Toggle.Tab targets ButtonBase, which
             RadioButton derives from. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <RadioButton Content="信息"
                       Style="{StaticResource Toggle.Tab}"
                       GroupName="ChatTabs"
                       Margin="0,0,4,0"
                       IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=Info}" />
          <RadioButton Content="聊天"
                       Style="{StaticResource Toggle.Tab}"
                       GroupName="ChatTabs"
                       Margin="0,0,4,0"
                       IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=Chat}" />
          <RadioButton Content="文件"
                       Style="{StaticResource Toggle.Tab}"
                       GroupName="ChatTabs"
                       IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=Files}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Messages ===== -->
    <Grid Grid.Row="1">
      <Grid.Style>
        <!-- A DataTrigger rather than a converter binding: EnumMatchConverter yields a bool, and
             chaining it into a Visibility would need a second converter. -->
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ActiveTab}" Value="Chat">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>

      <ListBox x:Name="MessageList"
               ItemsSource="{Binding Messages}"
               Padding="8,8,8,0"
               ItemContainerStyle="{StaticResource ListItem.Message}"
               VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="6,0,6,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource Size.AvatarSmallColumn}" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Avatar and the name/time line only appear on the first message of a run. -->
              <Border Grid.Row="0"
                      Grid.Column="0"
                      Width="{StaticResource Size.AvatarSmall}"
                      Height="{StaticResource Size.AvatarSmall}"
                      Background="{StaticResource Brush.SurfaceOverlay}"
                      CornerRadius="{StaticResource Radius.Pill}"
                      VerticalAlignment="Top"
                      Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVisibility}}">
                <controls:IconGlyph HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                  <controls:IconGlyph.Style>
                    <Style TargetType="controls:IconGlyph" BasedOn="{StaticResource Icon.Small}">
                      <Setter Property="Data" Value="{StaticResource Icon.User}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFromServer}" Value="True">
                          <Setter Property="Data" Value="{StaticResource Icon.Info}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPoke}" Value="True">
                          <Setter Property="Data" Value="{StaticResource Icon.Bell}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:IconGlyph.Style>
                </controls:IconGlyph>
              </Border>

              <StackPanel Grid.Row="0"
                          Grid.Column="1"
                          Orientation="Horizontal"
                          Margin="8,0,0,2"
                          Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SenderName}"
                           FontWeight="SemiBold"
                           Foreground="{Binding SenderUid, Converter={StaticResource NickColor}}" />
                <TextBlock Text="{Binding TimeText}"
                           Style="{StaticResource Text.Caption}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Bottom"
                           ToolTip="{Binding TimeTooltip}" />
                <Border Style="{StaticResource Badge}"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsPoke, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="戳一下" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextOnAccent}" />
                </Border>
                <Border Style="{StaticResource Badge}"
                        Margin="8,0,0,0"
                        Background="{StaticResource Brush.SurfaceOverlay}"
                        Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="私聊" Style="{StaticResource Text.Caption}" />
                </Border>
              </StackPanel>

              <!-- Merged lines show their timestamp in the left gutter on hover, so a long run of
                   messages stays readable but the time is still reachable. -->
              <TextBlock Grid.Row="1"
                         Grid.Column="0"
                         Text="{Binding TimeText}"
                         HorizontalAlignment="Right"
                         Margin="0,1,4,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsMerged}" Value="True" />
                          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- BBCode is not parsed yet; that lands with the chat panel task. Selectable so the
                   text can be copied in the meantime. -->
              <TextBox Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding Text, Mode=OneWay}"
                       Margin="8,0,0,4"
                       Padding="0"
                       Background="Transparent"
                       BorderThickness="0"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       Cursor="Arrow">
                <TextBox.Style>
                  <Style TargetType="TextBox">
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                    <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFromServer}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                        <Setter Property="FontStyle" Value="Italic" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBox.Style>
              </TextBox>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="还没有消息"
                 Style="{StaticResource Text.BodySecondary}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="{Binding Messages.Count, Converter={StaticResource ZeroToVisibility}}" />
    </Grid>

    <!-- Info and Files are placeholders until their own tasks. -->
    <TextBlock Grid.Row="1"
               Text="服务器与频道信息将在此显示"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodySecondary}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ActiveTab}" Value="Info">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <TextBlock Grid.Row="1"
               Text="频道文件将在此显示"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodySecondary}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ActiveTab}" Value="Files">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <!-- ===== Composer ===== -->
    <Border Grid.Row="2"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="10,8">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ActiveTab}" Value="Chat">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <StackPanel>
        <!-- BBCode toolbar. Tag carries the tag name so one handler covers all of them. -->
        <WrapPanel>
          <Button Style="{StaticResource Button.IconSmall}" Tag="b" Click="OnBbCodeClick" ToolTip="粗体">
            <controls:IconGlyph Data="{StaticResource Icon.Bold}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Button Style="{StaticResource Button.IconSmall}" Tag="i" Click="OnBbCodeClick" ToolTip="斜体">
            <controls:IconGlyph Data="{StaticResource Icon.Italic}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Button Style="{StaticResource Button.IconSmall}" Tag="u" Click="OnBbCodeClick" ToolTip="下划线">
            <controls:IconGlyph Data="{StaticResource Icon.Underline}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Button Style="{StaticResource Button.IconSmall}" Tag="s" Click="OnBbCodeClick" ToolTip="删除线">
            <controls:IconGlyph Data="{StaticResource Icon.Strikethrough}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Border Width="1"
                  Height="18"
                  Margin="6,0"
                  VerticalAlignment="Center"
                  Background="{StaticResource Brush.BorderSubtle}" />
          <Button Style="{StaticResource Button.IconSmall}" Tag="url" Click="OnBbCodeClick" ToolTip="链接">
            <controls:IconGlyph Data="{StaticResource Icon.Link}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Button Style="{StaticResource Button.IconSmall}" Tag="quote" Click="OnBbCodeClick" ToolTip="引用">
            <controls:IconGlyph Data="{StaticResource Icon.Quote}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Button Style="{StaticResource Button.IconSmall}" Tag="list" Click="OnBbCodeClick" ToolTip="列表">
            <controls:IconGlyph Data="{StaticResource Icon.List}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Button Style="{StaticResource Button.IconSmall}" Tag="code" Click="OnBbCodeClick" ToolTip="代码">
            <controls:IconGlyph Data="{StaticResource Icon.Code}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Button Style="{StaticResource Button.IconSmall}" Tag="spoiler" Click="OnBbCodeClick" ToolTip="剧透">
            <controls:IconGlyph Data="{StaticResource Icon.Spoiler}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Button Style="{StaticResource Button.IconSmall}" Tag="h1" Click="OnBbCodeClick" ToolTip="标题">
            <controls:IconGlyph Data="{StaticResource Icon.Heading}" Style="{StaticResource Icon.Small}" />
          </Button>
          <Button Style="{StaticResource Button.IconSmall}" ToolTip="更多" IsEnabled="False">
            <controls:IconGlyph Data="{StaticResource Icon.More}" Style="{StaticResource Icon.Small}" />
          </Button>
        </WrapPanel>

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Enter sends and Shift+Enter inserts a newline, so AcceptsReturn stays on and the key
               is handled in code-behind. -->
          <TextBox x:Name="Composer"
                   Grid.Column="0"
                   Style="{StaticResource TextBox.Multiline}"
                   Tag="发送消息…"
                   Text="{Binding MessageDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PreviewKeyDown="OnComposerKeyDown"
                   IsEnabled="{Binding IsConnected}" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,0">
            <Button Style="{StaticResource Button.IconSmall}" ToolTip="表情" IsEnabled="False">
              <controls:IconGlyph Data="{StaticResource Icon.Emoji}" Style="{StaticResource Icon.Small}" />
            </Button>
            <Button Style="{StaticResource Button.IconSmall}" ToolTip="附件" IsEnabled="False">
              <controls:IconGlyph Data="{StaticResource Icon.Attachment}" Style="{StaticResource Icon.Small}" />
            </Button>
            <Button Style="{StaticResource Button.Icon}"
                    Command="{Binding SendMessageCommand}"
                    ToolTip="发送 (Enter)">
              <controls:IconGlyph Data="{StaticResource Icon.Send}" />
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
