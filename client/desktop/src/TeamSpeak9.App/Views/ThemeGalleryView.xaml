<UserControl x:Class="TeamSpeak9.App.Views.ThemeGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TeamSpeak9.App.Controls">

  <!-- Development-only surface used to eyeball the theme. Replaced by the real shell in
       desktop-shell-layout. -->
  <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <TextBlock Text="主题预览" Style="{StaticResource Text.Title}" />
      <TextBlock Text="用于核对深色主题的配色、控件模板与图标观感。"
                 Style="{StaticResource Text.BodySecondary}"
                 Margin="0,4,0,0" />

      <!-- ===== Buttons ===== -->
      <TextBlock Text="按钮" Style="{StaticResource Text.Subtitle}" Margin="0,24,0,10" />
      <WrapPanel>
        <Button Content="主要操作" Style="{StaticResource Button.Primary}" Margin="0,0,8,8" />
        <Button Content="次要操作" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
        <Button Content="幽灵按钮" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8" />
        <Button Content="删除" Style="{StaticResource Button.Danger}" Margin="0,0,8,8" />
        <Button Content="禁用" Style="{StaticResource Button.Primary}" IsEnabled="False" Margin="0,0,8,8" />
        <Button Style="{StaticResource Button.Icon}" ToolTip="设置" Margin="0,0,8,8">
          <controls:IconGlyph Data="{StaticResource Icon.Gear}" />
        </Button>
        <Button Style="{StaticResource Button.IconSmall}" ToolTip="刷新" Margin="0,0,8,8">
          <controls:IconGlyph Data="{StaticResource Icon.Refresh}" Style="{StaticResource Icon.Small}" />
        </Button>
      </WrapPanel>

      <!-- ===== Toggles ===== -->
      <TextBlock Text="开关" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,10" />
      <WrapPanel>
        <ToggleButton Style="{StaticResource Toggle.Pill}" ToolTip="麦克风" Margin="0,0,8,8">
          <controls:IconGlyph Data="{StaticResource Icon.Mic}" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource Toggle.Pill}" IsChecked="True" ToolTip="已静音" Margin="0,0,8,8">
          <controls:IconGlyph Data="{StaticResource Icon.MicOff}" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource Toggle.Pill}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal">
            <controls:IconGlyph Data="{StaticResource Icon.Clock}" Style="{StaticResource Icon.Small}" />
            <TextBlock Text="离开" Margin="6,0,0,0" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Content="信息" Style="{StaticResource Toggle.Tab}" IsChecked="True" Margin="0,0,4,8" />
        <ToggleButton Content="聊天" Style="{StaticResource Toggle.Tab}" Margin="0,0,4,8" />
        <ToggleButton Content="文件" Style="{StaticResource Toggle.Tab}" Margin="0,0,12,8" />
        <ToggleButton Style="{StaticResource Toggle.Switch}" IsChecked="True" Margin="0,4,8,8" />
        <ToggleButton Style="{StaticResource Toggle.Switch}" Margin="0,4,8,8" />
      </WrapPanel>

      <!-- ===== Inputs ===== -->
      <TextBlock Text="输入" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,10" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <!-- Tag carries the placeholder; see TextBox.Base's PART_Placeholder. -->
          <TextBox Tag="搜索或连接服务器" />
          <Grid Margin="0,8,0,0">
            <TextBox Style="{StaticResource TextBox.Search}" Tag="搜索书签" />
            <controls:IconGlyph Data="{StaticResource Icon.Search}"
                                Style="{StaticResource Icon.Small}"
                                HorizontalAlignment="Left"
                                Margin="10,0,0,0"
                                IsHitTestVisible="False" />
          </Grid>
          <PasswordBox Margin="0,8,0,0" />
          <ComboBox Margin="0,8,0,0" SelectedIndex="0">
            <ComboBoxItem Content="默认输入设备" />
            <ComboBoxItem Content="麦克风 (USB Audio)" />
            <ComboBoxItem Content="立体声混音" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBox Style="{StaticResource TextBox.Multiline}" Tag="发送消息到 #大厅" />
          <CheckBox Content="开机自动启动" IsChecked="True" Margin="0,10,0,0" />
          <CheckBox Content="最小化到托盘" Margin="0,8,0,0" />
          <RadioButton Content="SFU 转发" IsChecked="True" Margin="0,10,0,0" GroupName="Mode" />
          <RadioButton Content="P2P 直连" Margin="0,8,0,0" GroupName="Mode" />
          <Slider Value="70" Maximum="100" Margin="0,12,0,0" />
          <ProgressBar Value="45" Maximum="100" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>

      <!-- ===== Channel tree ===== -->
      <TextBlock Text="频道树与成员" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="8">
        <TreeView>
          <TreeViewItem IsExpanded="True">
            <TreeViewItem.Header>
              <StackPanel Orientation="Horizontal">
                <controls:IconGlyph Data="{StaticResource Icon.Channel}" Style="{StaticResource Icon.Small}" />
                <TextBlock Text="大厅" Margin="6,0,0,0" />
                <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                  <TextBlock Text="3" Style="{StaticResource Text.Caption}"
                             Foreground="{StaticResource Brush.TextOnAccent}"
                             HorizontalAlignment="Center" />
                </Border>
              </StackPanel>
            </TreeViewItem.Header>
            <TreeViewItem>
              <TreeViewItem.Header>
                <StackPanel Orientation="Horizontal">
                  <controls:IconGlyph Data="{StaticResource Icon.User}" Style="{StaticResource Icon.Small}" />
                  <TextBlock Text="MoonCC" Margin="6,0,0,0" Foreground="{StaticResource Brush.Nick0}" />
                  <controls:IconGlyph Data="{StaticResource Icon.Flag}" Style="{StaticResource Icon.Small}" Margin="6,0,0,0" />
                </StackPanel>
              </TreeViewItem.Header>
            </TreeViewItem>
            <TreeViewItem>
              <TreeViewItem.Header>
                <StackPanel Orientation="Horizontal">
                  <controls:IconGlyph Data="{StaticResource Icon.User}" Style="{StaticResource Icon.Small}" />
                  <TextBlock Text="访客" Margin="6,0,0,0" Foreground="{StaticResource Brush.Nick3}" />
                  <controls:IconGlyph Data="{StaticResource Icon.MicOff}"
                                      Style="{StaticResource Icon.Small}"
                                      Foreground="{StaticResource Brush.Danger}"
                                      Margin="6,0,0,0" />
                </StackPanel>
              </TreeViewItem.Header>
            </TreeViewItem>
          </TreeViewItem>
          <TreeViewItem IsExpanded="True">
            <TreeViewItem.Header>
              <StackPanel Orientation="Horizontal">
                <controls:IconGlyph Data="{StaticResource Icon.Lock}" Style="{StaticResource Icon.Small}" />
                <TextBlock Text="管理员频道" Margin="6,0,0,0" />
              </StackPanel>
            </TreeViewItem.Header>
            <TreeViewItem>
              <TreeViewItem.Header>
                <StackPanel Orientation="Horizontal">
                  <controls:IconGlyph Data="{StaticResource Icon.ScreenShare}"
                                      Style="{StaticResource Icon.Small}"
                                      Foreground="{StaticResource Brush.Success}" />
                  <TextBlock Text="正在共享屏幕" Margin="6,0,0,0" />
                </StackPanel>
              </TreeViewItem.Header>
            </TreeViewItem>
          </TreeViewItem>
        </TreeView>
      </Border>

      <!-- ===== List ===== -->
      <TextBlock Text="列表与右键菜单" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card.Raised}" Padding="6">
        <ListBox SelectedIndex="1" MaxHeight="150">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="连接">
                <MenuItem.Icon>
                  <controls:IconGlyph Data="{StaticResource Icon.Server}" Style="{StaticResource Icon.Small}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="编辑" InputGestureText="F2" />
              <Separator />
              <MenuItem Header="更多">
                <MenuItem Header="复制地址" />
                <MenuItem Header="导出书签" />
              </MenuItem>
              <Separator />
              <MenuItem Header="删除" InputGestureText="Del" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBoxItem Content="ts.example.com" />
          <ListBoxItem Content="本地测试服务器" />
          <ListBoxItem Content="社区服务器" />
          <ListBoxItem Content="已禁用条目" IsEnabled="False" />
        </ListBox>
      </Border>

      <!-- ===== Icons ===== -->
      <TextBlock Text="图标" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="12">
        <WrapPanel>
          <controls:IconGlyph Data="{StaticResource Icon.Bell}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Clock}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Mic}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.MicOff}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Speaker}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.SpeakerOff}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Headphones}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Search}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Plus}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.ChevronDown}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.CollapseAll}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.More}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Check}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Refresh}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Server}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Globe}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Bookmark}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Folder}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.FolderPlus}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Gear}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Location}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Layout}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Channel}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.User}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Users}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Flag}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Lock}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Trash}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Edit}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Chat}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Info}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.File}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Image}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Emoji}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Attachment}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Send}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Download}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Upload}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Copy}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Bold}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Italic}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Underline}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Strikethrough}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Link}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Quote}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.List}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Code}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Spoiler}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Heading}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.ScreenShare}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Monitor}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Live}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Fullscreen}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.FullscreenExit}" Margin="6" />
          <controls:IconGlyph Data="{StaticResource Icon.Sliders}" Margin="6" />
        </WrapPanel>
      </Border>

      <!-- ===== Palette ===== -->
      <TextBlock Text="配色" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,10" />
      <WrapPanel>
        <Border Width="88" Height="52" Margin="0,0,8,8" CornerRadius="{StaticResource Radius.Medium}"
                Background="{StaticResource Brush.Background}"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1">
          <TextBlock Text="Background" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
        </Border>
        <Border Width="88" Height="52" Margin="0,0,8,8" CornerRadius="{StaticResource Radius.Medium}"
                Background="{StaticResource Brush.Surface}">
          <TextBlock Text="Surface" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
        </Border>
        <Border Width="88" Height="52" Margin="0,0,8,8" CornerRadius="{StaticResource Radius.Medium}"
                Background="{StaticResource Brush.SurfaceRaised}">
          <TextBlock Text="Raised" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
        </Border>
        <Border Width="88" Height="52" Margin="0,0,8,8" CornerRadius="{StaticResource Radius.Medium}"
                Background="{StaticResource Brush.SurfaceOverlay}">
          <TextBlock Text="Overlay" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
        </Border>
        <Border Width="88" Height="52" Margin="0,0,8,8" CornerRadius="{StaticResource Radius.Medium}"
                Background="{StaticResource Brush.Accent}">
          <TextBlock Text="Accent" Style="{StaticResource Text.Caption}"
                     Foreground="{StaticResource Brush.TextOnAccent}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
        </Border>
        <Border Width="88" Height="52" Margin="0,0,8,8" CornerRadius="{StaticResource Radius.Medium}"
                Background="{StaticResource Brush.Success}">
          <TextBlock Text="Success" Style="{StaticResource Text.Caption}"
                     Foreground="{StaticResource Brush.SurfaceSunken}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
        </Border>
        <Border Width="88" Height="52" Margin="0,0,8,8" CornerRadius="{StaticResource Radius.Medium}"
                Background="{StaticResource Brush.Warning}">
          <TextBlock Text="Warning" Style="{StaticResource Text.Caption}"
                     Foreground="{StaticResource Brush.SurfaceSunken}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
        </Border>
        <Border Width="88" Height="52" Margin="0,0,8,8" CornerRadius="{StaticResource Radius.Medium}"
                Background="{StaticResource Brush.Danger}">
          <TextBlock Text="Danger" Style="{StaticResource Text.Caption}"
                     Foreground="{StaticResource Brush.SurfaceSunken}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
        </Border>
      </WrapPanel>

      <!-- ===== Type ramp ===== -->
      <TextBlock Text="字体" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,10" />
      <StackPanel>
        <TextBlock Text="Title 20 · 标题文本" Style="{StaticResource Text.Title}" />
        <TextBlock Text="Subtitle 16 · 副标题文本" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
        <TextBlock Text="Body 13 · 正文文本 The quick brown fox 0123456789" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
        <TextBlock Text="BodySecondary 13 · 次要正文" Style="{StaticResource Text.BodySecondary}" Margin="0,4,0,0" />
        <TextBlock Text="SECTIONHEADER 11 · 分组标题" Style="{StaticResource Text.SectionHeader}" Margin="0,4,0,0" />
        <TextBlock Text="Caption 11 · 说明文本" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
        <TextBlock Text="Mono 12 · icon_3141592653 / cid=7" Style="{StaticResource Text.Mono}" Margin="0,4,0,20" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
