<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TeamSpeak9.App.Controls">

  <!-- Default template for IconGlyph. Stretch="Uniform" scales the shared 24x24 geometry to
       whatever Width/Height the call site sets; StrokeThickness is therefore expressed in the
       geometry's own units, which keeps line weight visually constant across sizes. -->
  <Style TargetType="{x:Type controls:IconGlyph}">
    <Setter Property="Width" Value="{StaticResource Size.IconMedium}" />
    <Setter Property="Height" Value="{StaticResource Size.IconMedium}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:IconGlyph}">
          <Path x:Name="PART_Path"
                Data="{TemplateBinding Data}"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="{TemplateBinding StrokeThickness}"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Stretch="Uniform"
                SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsFilled" Value="True">
              <Setter TargetName="PART_Path" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="PART_Path" Property="Stroke" Value="{x:Null}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Icon.Small" TargetType="{x:Type controls:IconGlyph}" BasedOn="{StaticResource {x:Type controls:IconGlyph}}">
    <Setter Property="Width" Value="{StaticResource Size.IconSmall}" />
    <Setter Property="Height" Value="{StaticResource Size.IconSmall}" />
    <Setter Property="StrokeThickness" Value="1.9" />
  </Style>

  <Style x:Key="Icon.Large" TargetType="{x:Type controls:IconGlyph}" BasedOn="{StaticResource {x:Type controls:IconGlyph}}">
    <Setter Property="Width" Value="{StaticResource Size.IconLarge}" />
    <Setter Property="Height" Value="{StaticResource Size.IconLarge}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>

  <!-- Status dots and other filled marks. -->
  <Style x:Key="Icon.Filled" TargetType="{x:Type controls:IconGlyph}" BasedOn="{StaticResource {x:Type controls:IconGlyph}}">
    <Setter Property="IsFilled" Value="True" />
  </Style>

</ResourceDictionary>
