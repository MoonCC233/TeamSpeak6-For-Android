<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ===== Base ===== -->
  <!-- Every button style derives from this. The template exposes PART_Root so derived styles
       can retarget the background without redefining the visual tree. -->
  <Style x:Key="Button.Base" TargetType="ButtonBase">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Transparent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Grid>
            <Border x:Name="PART_Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Medium}"
                    SnapsToDevicePixels="True">
              <ContentPresenter x:Name="PART_Content"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <!-- Keyboard focus ring drawn outside PART_Root so hover fills never cover it. -->
            <Border x:Name="PART_Focus"
                    BorderBrush="{StaticResource Brush.Focus}"
                    BorderThickness="1.5"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Margin="-2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="PART_Focus" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
              <Setter TargetName="PART_Root" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Primary ===== -->
  <Style x:Key="Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.AccentHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.AccentPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Secondary ===== -->
  <Style x:Key="Button.Secondary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceOverlay}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceSunken}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Ghost ===== -->
  <!-- No chrome until hovered. Used for the sidebar rows and toolbar buttons. -->
  <Style x:Key="Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Danger ===== -->
  <Style x:Key="Button.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.DangerHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Icon ===== -->
  <!-- Square, no padding: content is expected to be a single IconGlyph. Because the content is a
       shape rather than text, ButtonBaseAutomationPeer has nothing to derive a name from, so the
       tooltip doubles as the accessible name. -->
  <Style x:Key="Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
  </Style>

  <Style x:Key="Button.IconSmall" TargetType="ButtonBase" BasedOn="{StaticResource Button.Icon}">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
  </Style>

  <!-- ===== Window caption ===== -->
  <!-- Win11 caption metrics: 46x32, square corners, full-bleed hover. WindowChrome.IsHitTestVisibleInChrome
       is required or the non-client area swallows the click. The tooltip also feeds
       AutomationProperties.Name so UI automation can address these icon-only buttons. -->
  <Style x:Key="Button.Caption" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="PART_Root" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.CaptionClose" TargetType="ButtonBase" BasedOn="{StaticResource Button.Caption}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.CloseHover}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.ClosePressed}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Toggle ===== -->
  <!-- Mic / speaker / AFK in the top bar: off state is the accent-tinted "active" look,
       checked means muted, matching the official client where a lit button means muted. -->
  <Style x:Key="Toggle.Pill" TargetType="ToggleButton" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Pill}"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceOverlay}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsChecked" Value="True" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource Brush.DangerHover}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!-- Segmented tab look for the chat panel's 信息 / 聊天 / 文件 switch. -->
  <Style x:Key="Toggle.Tab" TargetType="ToggleButton" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Radius.Small}"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Selected}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Sliding switch for settings pages. -->
  <Style x:Key="Toggle.Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="PART_Track"
                  Background="{StaticResource Brush.SurfaceOverlay}"
                  BorderBrush="{StaticResource Brush.BorderStrong}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Pill}">
            <Ellipse x:Name="PART_Thumb"
                     Width="14" Height="14"
                     Margin="2,0,0,0"
                     HorizontalAlignment="Left"
                     Fill="{StaticResource Brush.TextSecondary}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="PART_Track" Property="Background" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="PART_Track" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="PART_Thumb" Property="Margin" Value="0,0,2,0" />
              <Setter TargetName="PART_Thumb" Property="Fill" Value="{StaticResource Brush.TextOnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Implicit defaults so unstyled buttons are never the OS grey. -->
  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />
  <Style TargetType="RepeatButton" BasedOn="{StaticResource Button.Ghost}" />
  <Style TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Pill}" />

</ResourceDictionary>
