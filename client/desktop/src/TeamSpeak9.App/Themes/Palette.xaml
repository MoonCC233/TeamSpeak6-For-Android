<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Dark palette approximating the TeamSpeak 6 client. Every colour used anywhere in the
       app is declared here; views reference the *Brush resources, never a literal colour. -->

  <!-- ===== Surfaces ===== -->
  <Color x:Key="Color.Background">#FF16181D</Color>
  <Color x:Key="Color.Surface">#FF1E2129</Color>
  <Color x:Key="Color.SurfaceRaised">#FF252932</Color>
  <Color x:Key="Color.SurfaceOverlay">#FF2C313C</Color>
  <Color x:Key="Color.SurfaceSunken">#FF12141A</Color>

  <!-- ===== Lines ===== -->
  <Color x:Key="Color.BorderSubtle">#FF2A2F3A</Color>
  <Color x:Key="Color.BorderStrong">#FF3A4150</Color>

  <!-- ===== Text ===== -->
  <Color x:Key="Color.TextPrimary">#FFE6E9EF</Color>
  <Color x:Key="Color.TextSecondary">#FFA0A7B4</Color>
  <Color x:Key="Color.TextTertiary">#FF6E7683</Color>
  <Color x:Key="Color.TextDisabled">#FF4E5561</Color>
  <Color x:Key="Color.TextOnAccent">#FFFFFFFF</Color>

  <!-- ===== Accent ===== -->
  <Color x:Key="Color.Accent">#FF3B82F6</Color>
  <Color x:Key="Color.AccentHover">#FF5A97F8</Color>
  <Color x:Key="Color.AccentPressed">#FF2D6FDD</Color>
  <Color x:Key="Color.AccentSubtle">#FF1E3A5F</Color>

  <!-- ===== Status ===== -->
  <Color x:Key="Color.Success">#FF34D399</Color>
  <Color x:Key="Color.Warning">#FFFBBF24</Color>
  <Color x:Key="Color.Danger">#FFF87171</Color>
  <Color x:Key="Color.DangerHover">#FFFB8E8E</Color>
  <!-- Windows uses this exact red for the close button; matching it keeps the chrome native. -->
  <Color x:Key="Color.CloseHover">#FFC42B1C</Color>
  <Color x:Key="Color.ClosePressed">#FFB2231A</Color>

  <!-- ===== Brushes: surfaces ===== -->
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.SurfaceOverlay" Color="{StaticResource Color.SurfaceOverlay}" />
  <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.SurfaceSunken}" />

  <!-- Hover / pressed washes, used on top of any surface. -->
  <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="Brush.Selected" Color="#1F3B82F6" />
  <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

  <!-- ===== Brushes: lines ===== -->
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Accent}" />

  <!-- ===== Brushes: text ===== -->
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
  <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}" />

  <!-- ===== Brushes: accent ===== -->
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />

  <!-- ===== Brushes: status ===== -->
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
  <SolidColorBrush x:Key="Brush.CloseHover" Color="{StaticResource Color.CloseHover}" />
  <SolidColorBrush x:Key="Brush.ClosePressed" Color="{StaticResource Color.ClosePressed}" />

  <!-- ===== Brushes: scrollbar ===== -->
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FF3A4150" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#FF4A5262" />
  <SolidColorBrush x:Key="Brush.ScrollThumbPressed" Color="#FF5A6474" />

  <!-- ===== Nickname colours =====
       Chat authors are tinted by hashing their uid into this list, the way the official
       client colours names. Kept deliberately light so they stay readable on dark surfaces. -->
  <SolidColorBrush x:Key="Brush.Nick0" Color="#FF7DD3FC" />
  <SolidColorBrush x:Key="Brush.Nick1" Color="#FF86EFAC" />
  <SolidColorBrush x:Key="Brush.Nick2" Color="#FFFDE68A" />
  <SolidColorBrush x:Key="Brush.Nick3" Color="#FFFCA5A5" />
  <SolidColorBrush x:Key="Brush.Nick4" Color="#FFD8B4FE" />
  <SolidColorBrush x:Key="Brush.Nick5" Color="#FFF9A8D4" />
  <SolidColorBrush x:Key="Brush.Nick6" Color="#FF99F6E4" />
  <SolidColorBrush x:Key="Brush.Nick7" Color="#FFFDBA74" />

  <!-- ===== Geometry ===== -->
  <CornerRadius x:Key="Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
  <CornerRadius x:Key="Radius.Large">10</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <sys:Double x:Key="Size.CaptionHeight">48</sys:Double>
  <sys:Double x:Key="Size.IconSmall">14</sys:Double>
  <sys:Double x:Key="Size.IconMedium">18</sys:Double>
  <sys:Double x:Key="Size.IconLarge">22</sys:Double>
  <sys:Double x:Key="Size.RowHeight">28</sys:Double>
  <sys:Double x:Key="Size.AvatarSmall">24</sys:Double>
  <sys:Double x:Key="Size.AvatarMedium">32</sys:Double>

</ResourceDictionary>
