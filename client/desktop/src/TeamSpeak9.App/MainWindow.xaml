<controls:ShellWindow x:Class="TeamSpeak9.App.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
                      xmlns:controls="clr-namespace:TeamSpeak9.App.Controls"
                      xmlns:conv="clr-namespace:TeamSpeak9.App.Converters"
                      xmlns:views="clr-namespace:TeamSpeak9.App.Views"
                      Title="TeamSpeak9"
                      Width="1280"
                      Height="800"
                      MinWidth="960"
                      MinHeight="600"
                      WindowStartupLocation="CenterScreen">

  <controls:ShellWindow.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityInverted" Invert="True" />
  </controls:ShellWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Caption ===== -->
    <!-- Windows owns this strip (WindowChrome.CaptionHeight), so dragging, double-click maximize,
         Aero Snap and the system menu work without any code here. Only the buttons opt back in
         to hit testing.
         The height comes from the same Double the WindowChrome uses; the row is Auto because
         RowDefinition.Height wants a GridLength and XAML will not coerce a Double resource. -->
    <Grid Grid.Row="0"
          Height="{StaticResource Size.CaptionHeight}"
          Background="{StaticResource Brush.Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
        <controls:IconGlyph Data="{StaticResource Icon.Bell}" Style="{StaticResource Icon.Large}" />
        <TextBlock Text="teamspeak" Style="{StaticResource Text.Subtitle}" Margin="12,0,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  VerticalAlignment="Top"
                  Margin="0,8,8,0">
        <Button Style="{StaticResource Button.Caption}"
                Command="{x:Static sw:SystemCommands.MinimizeWindowCommand}"
                ToolTip="最小化">
          <controls:IconGlyph Data="{StaticResource Icon.Minimize}" Style="{StaticResource Icon.Small}" />
        </Button>
        <Button Style="{StaticResource Button.Caption}"
                Command="{x:Static sw:SystemCommands.MaximizeWindowCommand}"
                Visibility="{Binding IsMaximized, RelativeSource={RelativeSource AncestorType=controls:ShellWindow}, Converter={StaticResource BoolToVisibilityInverted}}"
                ToolTip="最大化">
          <controls:IconGlyph Data="{StaticResource Icon.Maximize}" Style="{StaticResource Icon.Small}" />
        </Button>
        <Button Style="{StaticResource Button.Caption}"
                Command="{x:Static sw:SystemCommands.RestoreWindowCommand}"
                Visibility="{Binding IsMaximized, RelativeSource={RelativeSource AncestorType=controls:ShellWindow}, Converter={StaticResource BoolToVisibility}}"
                ToolTip="向下还原">
          <controls:IconGlyph Data="{StaticResource Icon.Restore}" Style="{StaticResource Icon.Small}" />
        </Button>
        <Button Style="{StaticResource Button.CaptionClose}"
                Command="{x:Static sw:SystemCommands.CloseWindowCommand}"
                ToolTip="关闭">
          <controls:IconGlyph Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== Body ===== -->
    <!-- Placeholder content. The three-column layout lands in desktop-shell-layout; until then
         this hosts the theme gallery so the styles can be reviewed. -->
    <Grid Grid.Row="1">
      <views:ThemeGalleryView />
      <TextBlock x:Name="StatusText"
                 Style="{StaticResource Text.Caption}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,24,8"
                 IsHitTestVisible="False" />
    </Grid>
  </Grid>
</controls:ShellWindow>
