+		private static string HexDump(ReadOnlySpan<byte> data)
+		{
+			var len = Math.Min(data.Length, 64);
+			var sb = new System.Text.StringBuilder(len * 3);
+			for (int i = 0; i < len; i++)
+				sb.Append(data[i].ToString("X2")).Append(' ');
+			if (data.Length > len)
+				sb.Append("... (").Append(data.Length).Append(" bytes total)");
+			return sb.ToString();
+		}
